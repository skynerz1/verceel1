{
    "version": 2,
    "crons": [
        {
            "path": "/api/cron",
            "schedule": "* * * * *"
        }
    ],
    "functions": {
        "api/cron.js": {
            "maxDuration": 60
        }
    },
    "rewrites": [
        {
            "source": "/",
            "destination": "/api/cron"
        }
    ]
}
